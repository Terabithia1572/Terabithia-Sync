<Application x:Class="ScheduledCopyManager.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ScheduledCopyManager.Presentation.ViewModels;assembly=ScheduledCopyManager.Presentation"
             xmlns:views="clr-namespace:ScheduledCopyManager.Presentation.Views;assembly=ScheduledCopyManager.Presentation"
             xmlns:converters="clr-namespace:ScheduledCopyManager.Presentation.Converters;assembly=ScheduledCopyManager.Presentation">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScheduledCopyManager.Presentation;component/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="pack://application:,,,/ScheduledCopyManager.Presentation;component/Resources/Strings.tr-TR.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:StatusToTextConverter x:Key="StatusToTextConverter" />
            <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
            <converters:BytesToFormattedSizeConverter x:Key="BytesToFormattedConverter" />
            <converters:EnumToTurkishConverter x:Key="EnumToTurkishConverter" />

            <!-- ViewModel to View DataTemplates -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:JobsViewModel}">
                <views:JobsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ToolsViewModel}">
                <views:ToolsView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
                <views:WelcomeView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
