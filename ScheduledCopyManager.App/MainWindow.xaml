<Window x:Class="ScheduledCopyManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:ScheduledCopyManager.Presentation.Views;assembly=ScheduledCopyManager.Presentation"
        mc:Ignorable="d"
        Title="Terabithia Sync - Zamanlı Dosya ve Klasör Kopyalama Yöneticisi" 
        Height="700" Width="1100" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="#0F172A">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Branding Header -->
                <StackPanel Grid.Row="0" Margin="20,25,20,0">
                    <TextBlock Text="Terabithia Sync" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Kopyalama Yöneticisi" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Nav Links -->
                <StackPanel Grid.Row="2" Margin="10,0">
                    <Button Content="{DynamicResource Str_Nav_Dashboard}" Command="{Binding NavigateToDashboardCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>

                    <Button Content="{DynamicResource Str_Nav_Jobs}" Command="{Binding NavigateToJobsCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>

                    <Button Content="{DynamicResource Str_Nav_History}" Command="{Binding NavigateToHistoryCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>

                    <Button Content="{DynamicResource Str_Nav_Logs}" Command="{Binding NavigateToLogsCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>

                    <Button Content="{DynamicResource Str_Nav_Settings}" Command="{Binding NavigateToSettingsCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>

                    <Button Content="{DynamicResource Str_Nav_Tools}" Command="{Binding NavigateToToolsCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>

                    <Button Content="{DynamicResource Str_Nav_About}" Command="{Binding NavigateToAboutCommand}" 
                            HorizontalContentAlignment="Left" Padding="15,12" FontSize="13" FontWeight="SemiBold"
                            Foreground="White" Background="Transparent" BorderThickness="0" Margin="0,2" Cursor="Hand"/>
                </StackPanel>

                <!-- App Version Label -->
                <TextBlock Grid.Row="3" Text="v1.0.0 | © Yunus İNAN" Foreground="#64748B" FontSize="11" Margin="20" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}" />

            <!-- First Run Welcome Overlay -->
            <ContentControl Content="{Binding WelcomeVM}" 
                            Visibility="{Binding IsWelcomeVisible, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
        </Grid>
    </Grid>
</Window>
