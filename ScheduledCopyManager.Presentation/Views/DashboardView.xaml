<UserControl x:Class="ScheduledCopyManager.Presentation.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:ScheduledCopyManager.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="850">

    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:StatusToTextConverter x:Key="StatusToTextConverter" />
        <converters:BytesToFormattedSizeConverter x:Key="BytesToFormattedConverter" />
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="15"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Action -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Özet Panosu" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="Sistem Durumu: " FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SystemStatusText}" FontSize="13" Foreground="#10B981" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="🔄 Verileri Yenile" Command="{Binding RefreshDataCommand}" 
                    Padding="14,9" Style="{StaticResource ModernPrimaryButtonStyle}"/>
        </Grid>

        <!-- KPI Cards Grid -->
        <UniformGrid Grid.Row="2" Columns="5">
            <!-- Card 1: Total Jobs -->
            <Border Margin="4" Padding="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Toplam Görev" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalJobs}" FontSize="24" FontWeight="Bold" Foreground="#1E293B" Margin="0,4,0,0"/>
                    <TextBlock Text="Kayıtlı görevler" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Enabled Jobs -->
            <Border Margin="4" Padding="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Aktif Görevler" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding EnabledJobs}" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,4,0,0"/>
                    <TextBlock Text="Zamanlanmış" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Today Runs -->
            <Border Margin="4" Padding="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Bugünkü Çalışmalar" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TodayRunsCount}" FontSize="24" FontWeight="Bold" Foreground="#8B5CF6" Margin="0,4,0,0"/>
                    <TextBlock Text="Son 24 saatteki çalışma" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Next Scheduled Run -->
            <Border Margin="4" Padding="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="Yaklaşan Görev" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBlock Text="{Binding NextScheduledRunText}" FontSize="12" FontWeight="Bold" Foreground="#3B82F6" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock Text="Sonraki zamanlama" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 5: Success / Fail Summary -->
            <Border Margin="4" Padding="14" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="İşlem Sonuçları" FontSize="11" FontWeight="SemiBold" Foreground="#64748B"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SuccessCount}" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text=" Başarılı" FontSize="10" VerticalAlignment="Center" Foreground="#64748B"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding FailureCount}" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                        <TextBlock Text=" Hatalı" FontSize="10" VerticalAlignment="Center" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Recent History Section -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Son Kopyalama Hareketleri" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>

                <DataGrid Grid.Row="2" ItemsSource="{Binding RecentHistory}" AutoGenerateColumns="False" 
                          IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          Background="Transparent" RowHeaderWidth="0" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Görev Adı" Binding="{Binding JobName}" Width="180"/>
                        <DataGridTextColumn Header="Başlangıç" Binding="{Binding StartTime, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="150"/>
                        <DataGridTextColumn Header="Süre" Binding="{Binding Duration, StringFormat=\{0:mm\\:ss\}}" Width="80"/>
                        <DataGridTextColumn Header="Kopyalanan" Binding="{Binding FilesCopied}" Width="90"/>
                        <DataGridTextColumn Header="Hatalı" Binding="{Binding FilesFailed}" Width="80"/>
                        <DataGridTextColumn Header="Boyut" Binding="{Binding BytesCopied, Converter={StaticResource BytesToFormattedConverter}}" Width="100"/>
                        <DataGridTemplateColumn Header="Sonuç Durumu" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="6,2" CornerRadius="4" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
