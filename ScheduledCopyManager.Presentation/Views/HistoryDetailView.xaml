<Window x:Class="ScheduledCopyManager.Presentation.Views.HistoryDetailView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ScheduledCopyManager.Presentation.Converters"
        Title="Kopyalama Ayrıntıları - Terabithia Sync" Height="680" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToTextConverter x:Key="StatusToTextConverter"/>
        <converters:BytesToFormattedSizeConverter x:Key="BytesToFormattedConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Entry.JobName}" FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                    <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="4" VerticalAlignment="Center"
                            Background="{Binding Entry.Status, Converter={StaticResource StatusToColorConverter}}">
                        <TextBlock Text="{Binding Entry.Status, Converter={StaticResource StatusToTextConverter}}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding Entry.StartTime, StringFormat='Tarih: {0:dd.MM.yyyy HH:mm:ss}'}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Content="⚡ Başarısızların Tümünü Yeniden Dene" Command="{Binding RetryAllFailedCommand}"
                    Padding="14,8" Style="{StaticResource ModernDangerButtonStyle}"
                    Visibility="{Binding HasFailedFiles, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>

        <!-- Summary Banner Cards -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,15">
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Kopyalanan" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Entry.FilesCopied}" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="5,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Atlanan" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Entry.FilesSkipped}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="5,0,5,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Başarısız" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Entry.FilesFailed}" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                </StackPanel>
            </Border>
            <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="5,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Aktarılan Veri" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Entry.BytesCopied, Converter={StaticResource BytesToFormattedConverter}}" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter & Search Controls -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Filtrele: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" Padding="6,4"/>

                    <TextBlock Grid.Column="3" Text="🔍 Arama: " VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                    <TextBox Grid.Column="4" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- File Details List -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10">
                <DataGrid ItemsSource="{Binding DisplayFileResults}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Durum" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" Foreground="{Binding IconColor}" FontWeight="Bold" FontSize="14" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Dosya Adı" Binding="{Binding FileName}" Width="160"/>
                        <DataGridTextColumn Header="Göreceli Yol" Binding="{Binding RelativePath}" Width="200"/>
                        <DataGridTextColumn Header="Boyut" Binding="{Binding FileSize, Converter={StaticResource BytesToFormattedConverter}}" Width="90"/>
                        <DataGridTextColumn Header="Hata / Neden Detayı" Binding="{Binding ErrorMessage}" Width="*"/>
                        
                        <DataGridTemplateColumn Header="İşlem" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🔄 Yeniden Dene" Padding="6,3" Style="{StaticResource ModernSecondaryButtonStyle}"
                                            Command="{Binding DataContext.RetrySingleFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="{Binding RetryStatusMessage}" Foreground="#2563EB" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <Button Content="Kapat" Command="{Binding CloseCommand}" HorizontalAlignment="Right" Padding="16,8" Style="{StaticResource ModernSecondaryButtonStyle}"/>
        </Grid>
    </Grid>
</Window>
