<Window x:Class="ScheduledCopyManager.Presentation.Views.JobEditorView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ScheduledCopyManager.Presentation.Converters"
        Title="Kopyalama Görevi Düzenleyici - Terabithia Sync" Height="750" Width="780"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#F8FAFC">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EnumToTurkishConverter x:Key="EnumToTurkishConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Kopyalama Görevi Düzenle / Oluştur" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,15"/>

        <!-- Error & Info Banners -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,5"
                    Visibility="{Binding ValidationErrorMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ValidationErrorMessage}" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1" CornerRadius="6" Padding="10"
                    Visibility="{Binding TestResultMessage, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding TestResultMessage}" Foreground="#0369A1" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Form Scroll Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- General Section -->
                <GroupBox Header="Genel Ayarlar" Margin="0,0,0,15" Padding="12">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBlock Text="Görev Adı:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0,0,0,10"/>

                        <CheckBox IsChecked="{Binding Enabled}" Content="Bu görevi etkinleştir" Margin="0,5,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Source & Destination Section -->
                <GroupBox Header="Kaynaklar ve Hedef" Margin="0,0,0,15" Padding="12">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBlock Text="Kaynak Dosyalar / Klasörler:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ListBox x:Name="SourceListBox" ItemsSource="{Binding SourceItems}" Height="130" Grid.Column="0" Margin="0,0,10,0" SelectionMode="Extended">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            <Border Grid.Column="2" Background="#E2E8F0" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding TypeText}" FontSize="10" Foreground="#475569" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="❌ Seçiliyi Kaldır" Command="{Binding RemoveSelectedSourcesCommand}" CommandParameter="{Binding PlacementTarget.SelectedItems, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="🗑️ Tümünü Kaldır" Command="{Binding ClearAllSourcesCommand}"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                            </ListBox>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="📄 Dosya Ekle" Command="{Binding AddSourceFileCommand}" Padding="10,5" Margin="0,0,0,5" Style="{StaticResource ModernSecondaryButtonStyle}"
                                        ToolTip="Birden fazla dosya seçerek kaynak listesine ekleyebilirsiniz."/>
                                <Button Content="📁 Klasör Ekle" Command="{Binding AddSourceFolderCommand}" Padding="10,5" Margin="0,0,0,5" Style="{StaticResource ModernSecondaryButtonStyle}"
                                        ToolTip="Birden fazla klasör seçerek kaynak listesine ekleyebilirsiniz."/>
                                <Button Content="❌ Seçiliyi Kaldır" Command="{Binding RemoveSelectedSourcesCommand}" CommandParameter="{Binding SelectedItems, ElementName=SourceListBox}" Padding="10,5" Margin="0,0,0,5" Style="{StaticResource ModernDangerButtonStyle}"
                                        ToolTip="Listeden seçtiğiniz ögeleri kaldırır."/>
                                <Button Content="🗑️ Tümünü Kaldır" Command="{Binding ClearAllSourcesCommand}" Padding="10,5" Style="{StaticResource ModernSecondaryButtonStyle}"
                                        ToolTip="Tüm kaynak listesini temizler."/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Hedef Klasör Yolu:" Margin="0,8,0,5" FontWeight="SemiBold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DestinationPath, UpdateSourceTrigger=PropertyChanged}" Padding="6" Grid.Column="0"/>
                            <Button Content="Gözat..." Command="{Binding BrowseDestinationFolderCommand}" Padding="12,6" Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource ModernPrimaryButtonStyle}"/>
                        </Grid>

                        <CheckBox IsChecked="{Binding IsUsbDestination}" Content="USB Taşınabilir Sürücü Hedefi" Margin="0,10,0,0"/>

                        <StackPanel Margin="0,8,0,0" Visibility="{Binding IsUsbDestination, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="USB Sürücüsü Seçin:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableUsbDrives}" SelectedItem="{Binding SelectedUsbDrive}" Padding="6,4">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayText}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1" Content="🔄 Yenile" Command="{Binding RefreshUsbDrivesCommand}" Padding="10,5" Margin="8,0,0,0" Style="{StaticResource ModernSecondaryButtonStyle}"/>
                            </Grid>
                            <TextBlock Text="{Binding UsbStatusMessage}" Foreground="#D97706" FontSize="11" Margin="0,4,0,0"
                                       Visibility="{Binding HasUsbStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Bandwidth Limit Section -->
                <GroupBox Header="Aktarım Hızı Sınırı" Margin="0,0,0,15" Padding="12"
                          ToolTip="Bu ayar kopyalama işleminin ağ veya disk üzerindeki bant genişliği kullanımını sınırlar. Sınırsız seçildiğinde Terabithia Sync mümkün olan en yüksek aktarım hızını kullanır.">
                    <StackPanel TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bant Genişliği Limit:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding BandwidthPresets}" SelectedItem="{Binding SelectedBandwidthPreset}" Padding="6"/>
                        </Grid>

                        <Grid Margin="0,8,0,0" Visibility="{Binding IsCustomBandwidthVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Özel Hız Sınırı (MB/s):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding BandwidthLimitMBps, UpdateSourceTrigger=PropertyChanged}" Padding="6"/>
                        </Grid>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,8,0,0">
                            <TextBlock Text="ℹ️ Bu ayar kopyalama işleminin ağ veya disk üzerindeki bant genişliği kullanımını sınırlar. Sınırsız seçildiğinde Terabithia Sync mümkün olan en yüksek aktarım hızını kullanır." Foreground="#334155" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Schedule Section -->
                <GroupBox Header="Zamanlama ve Tarih" Margin="0,0,0,15" Padding="12">
                    <StackPanel TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Zamanlama Tipi:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ScheduleTypes}" SelectedItem="{Binding SelectedScheduleType}" Padding="6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToTurkishConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Başlangıç Saati:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <TextBox Grid.Column="1" Text="{Binding TimeOfDay, StringFormat=\{0:hh\\:mm\\:ss\}}" Padding="6"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kaçırılan Görev Davranışı:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MissedJobBehaviors}" SelectedItem="{Binding SelectedMissedJobBehavior}" Padding="6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToTurkishConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Copy Mode & Behavior Section -->
                <GroupBox Header="Kopyalama Modu ve Çakışma Davranışı" Margin="0,0,0,15" Padding="12">
                    <StackPanel TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Kopyalama Modu:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding CopyModes}" SelectedItem="{Binding SelectedCopyMode}" Padding="6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToTurkishConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Copy Mode Explanation Banner -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding CopyModeExplanation}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Çakışma Davranışı:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ConflictPolicies}" SelectedItem="{Binding SelectedConflictPolicy}" Padding="6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToTurkishConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <!-- Conflict Policy Explanation Banner -->
                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBlock Text="{Binding ConflictPolicyExplanation}" Foreground="#334155" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
                            <TextBlock Text="⚠️" Foreground="#DC2626" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <CheckBox IsChecked="{Binding EnableMirrorDeletion}" Content="Ayna Modu Silme İzni (Hedefte Fazla Olan Dosyaları Sil)" Foreground="#DC2626" FontWeight="SemiBold" VerticalAlignment="Center"
                                      ToolTip="Ayna Modu kullanılırken hedef klasörde bulunan ancak kaynak klasörde artık bulunmayan dosyaların silinmesine izin verir.&#10;&#10;Örneğin kaynak klasörde A.txt, B.txt var ve hedefte A.txt, B.txt, C.txt varsa bu seçenek etkinleştirildiğinde C.txt silinir.&#10;&#10;Dikkat: Bu seçenek hedef klasördeki dosyaların silinmesine neden olabilir. Emin olmadığınız durumlarda kapalı bırakmanız önerilir."/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding PreserveTimestamps}" Content="Zaman Damgalarını Koru" Margin="0,4,0,4"/>
                        <CheckBox IsChecked="{Binding ContinueOnError}" Content="Hata Durumunda Diğer Dosyalarla Devam Et" Margin="0,4,0,4"/>
                    </StackPanel>
                </GroupBox>

                <!-- Retry Policy Section -->
                <GroupBox Header="Otomatik Yeniden Deneme &amp; Hata Politikası" Margin="0,0,0,15" Padding="12">
                    <StackPanel TextElement.FontWeight="Normal">
                        <CheckBox IsChecked="{Binding EnableAutoRetry}" Content="Otomatik Yeniden Denemeyi Etkinleştir" FontWeight="SemiBold" Margin="0,0,0,10"/>

                        <StackPanel Visibility="{Binding EnableAutoRetry, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Maksimum Deneme Sayısı:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding MaxRetryAttempts}" Padding="6"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Denemeler Arası Bekleme (sn):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox Grid.Column="1" Text="{Binding RetryDelaySeconds}" Padding="6"/>
                            </Grid>

                            <CheckBox IsChecked="{Binding UseExponentialBackoff}" Content="Üstel Geri Çekilme (Exponential Backoff)" Margin="0,4,0,4"/>
                            <CheckBox IsChecked="{Binding RetryLockedFiles}" Content="Kilitli Dosyaları Yeniden Dene" Margin="0,4,0,4"/>
                            <CheckBox IsChecked="{Binding WaitForDestination}" Content="Erişilemeyen Hedefi Bekle" Margin="0,4,0,4"/>
                            <CheckBox IsChecked="{Binding ResumeWhenDestinationReturns}" Content="Hedef Bağlandığında Devam Et" Margin="0,4,0,10"/>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Bir Hata Oluştuğunda:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FailureBehaviors}" SelectedItem="{Binding SelectedFailureBehavior}" Padding="6">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumToTurkishConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Verification Mode Section -->
                <GroupBox Header="Doğrulama Yöntemi" Margin="0,0,0,15" Padding="12">
                    <StackPanel TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Doğrulama Yöntemi:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding VerificationModes}" SelectedItem="{Binding SelectedVerificationMode}" Padding="6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource EnumToTurkishConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>

                        <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="ℹ️ SHA-256 yöntemi en güçlü doğrulamayı sağlar ancak büyük dosyalar için işlem süresini uzatabilir." Foreground="#334155" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- Compact Job Summary Section -->
                <GroupBox Header="📋 Görev Konfigürasyon Özeti" Margin="0,0,0,15" Padding="12" Background="#F8FAFC">
                    <UniformGrid Columns="2" Rows="4">
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Görev Adı:</Run> <Run Text="{Binding Name}"/></TextBlock>
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Kaynak Öğe Sayısı:</Run> <Run Text="{Binding SourcePaths.Count, Mode=OneWay}"/> öğe</TextBlock>
                        <TextBlock Margin="0,4" TextTrimming="CharacterEllipsis"><Run FontWeight="Bold">Hedef:</Run> <Run Text="{Binding DestinationPath}"/></TextBlock>
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Zamanlama:</Run> <Run Text="{Binding SelectedScheduleType, Converter={StaticResource EnumToTurkishConverter}}"/></TextBlock>
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Kopyalama Modu:</Run> <Run Text="{Binding SelectedCopyMode, Converter={StaticResource EnumToTurkishConverter}}"/></TextBlock>
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Çakışma Politikası:</Run> <Run Text="{Binding SelectedConflictPolicy, Converter={StaticResource EnumToTurkishConverter}}"/></TextBlock>
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Doğrulama:</Run> <Run Text="{Binding SelectedVerificationMode, Converter={StaticResource EnumToTurkishConverter}}"/></TextBlock>
                        <TextBlock Margin="0,4"><Run FontWeight="Bold">Bant Genişliği:</Run> <Run Text="{Binding SelectedBandwidthPreset}"/></TextBlock>
                    </UniformGrid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3" Margin="0,15,0,0">
            <Button Content="🔍 Ön İzleme Çalıştırması" Command="{Binding TestJobCommand}" HorizontalAlignment="Left" Padding="14,8" Style="{StaticResource ModernSecondaryButtonStyle}"
                    ToolTip="Bu seçenek gerçek dosya kopyalama işlemini gerçekleştirmeden, hangi dosyaların kopyalanacağını ve işlemin sonucunun nasıl olacağını önceden kontrol etmenizi sağlar. Kaynak dosyalar değiştirilmez ve hedefe gerçek bir kopyalama yapılmaz."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="💾 Kaydet" Command="{Binding SaveCommand}" Padding="18,8" Margin="0,0,10,0" Style="{StaticResource ModernSuccessButtonStyle}"/>
                <Button Content="İptal" Command="{Binding CancelCommand}" Padding="16,8" Style="{StaticResource ModernSecondaryButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
