## Visual Studio / .NET Core / WPF .gitignore

# Build & Publish outputs
**/bin/
**/obj/
[Bb]in/
[Oo]bj/
Release/
InstallerOutput/
TestResults/
publish/
[Ll]og/
[Ll]ogs/

# Scratch & Temporary Tool Files
scratch/
*.tmp
*.log
*.bak
*.pdb

# User-specific files
*.user
*.userprefs
*.suo
*.userosscache
*.sln.docstates

# Visual Studio / IDE folders
.vs/
.idea/
.vscode/
*.swp

# OS generated files
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.DS_Store

# ReSharper / Rider
_ReSharper*/
*.ReSharper

# Paket / NuGet
*.nuget.props
*.nuget.targets
project.lock.json

# Local App settings / Credentials & Local Runtime Data
*.env
*.env.local
*.pfx
*.snk
checkpoints/
settings.json
